# ============================================
# 自然感官生态档案库 — 环境变量配置
# 复制为 .env 并填入真实值
# ============================================

# ===== 后端服务 =====
PORT=4000
NODE_ENV=development

# ===== 数据库（SQLite，零配置）=====
# 留空则使用默认路径 backend/data/nsea.db
DB_PATH=

# ===== JWT 认证（生产环境务必修改）=====
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ===== CORS 白名单（逗号分隔）=====
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# ===== 讯飞星火 Spark-X 大模型 API =====
# 用于「AI 分析报告」模块，在讯飞开放平台申请
# 不配则报告自动降级为模板分析
SPARK_API_KEY=
SPARK_MODEL=spark-x2.5-1.7b
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2

# ===== 前端构建时的后端地址 =====
VITE_API_BASE=http://localhost:4000/api
